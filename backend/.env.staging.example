APP_PROFILE=staging
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=edulearn_staging
JWT_SECRET=replace-with-a-unique-staging-secret-of-at-least-32-characters
JWT_EXPIRATION=86400000
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
PASSWORD_RESET_DEBUG_RETURN_TOKEN=false
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
CORS_ALLOWED_ORIGINS=http://localhost:4173,https://staging.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
