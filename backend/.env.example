MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=edulearn

# Must be at least 32 characters in production
JWT_SECRET=replace-with-a-strong-secret-at-least-32-chars

# 24 hours in milliseconds
JWT_EXPIRATION=86400000

# Optional CORS overrides for deployment
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
# CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=*
# CORS_ALLOW_CREDENTIALS=true

# Optional password reset behavior
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
PASSWORD_RESET_DEBUG_RETURN_TOKEN=false

# Optional runtime profile hints
APP_PROFILE=production

# Optional upload limit (bytes), default is 5242880 (5MB)
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
